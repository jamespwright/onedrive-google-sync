<?xml version="1.0"?>
<Container version="2">
  <Name>onedrive-google-sync</Name>
  <Repository>ghcr.io/jamespwright/onedrive-google-sync:latest</Repository>
  <Registry>https://github.com/jamespwright/onedrive-google-sync/pkgs/container/onedrive-google-sync</Registry>
  <Network>bridge</Network>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Overview>One-way sync of OneDrive albums (from one or more Microsoft accounts) into Google Photos albums, e.g. to feed a Nest Hub photo frame. Syncs daily at a time you choose, with a web UI for settings, account sign-in and a Sync now button.</Overview>
  <Category>Backup: Tools:</Category>
  <WebUI>http://[IP]:[PORT:8765]/</WebUI>
  <ExtraParams>--user 99:100 --restart unless-stopped</ExtraParams>
  <Config Name="Config" Target="/config" Default="/mnt/user/appdata/onedrive-google-sync" Mode="rw" Description="config.yaml, tokens and sync state" Type="Path" Display="always" Required="true">/mnt/user/appdata/onedrive-google-sync</Config>
  <Config Name="Web UI port" Target="8765" Default="8765" Mode="tcp" Description="Web UI" Type="Port" Display="always" Required="true">8765</Config>
  <Config Name="Web UI password" Target="WEB_PASSWORD" Default="" Mode="" Description="Optional. If set, the web UI asks for it (any username)." Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Log level" Target="LOG_LEVEL" Default="INFO" Mode="" Description="DEBUG, INFO, WARNING" Type="Variable" Display="advanced" Required="false">INFO</Config>
</Container>
